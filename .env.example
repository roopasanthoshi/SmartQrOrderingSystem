# =====================================================================
# Kanchi Cafe - Vercel Deployment Environment Variables
# =====================================================================
# Add these environment variables in your Vercel Project Settings -> Environment Variables.

# --- Database Configuration (Neon PostgreSQL) ---
# Use the pooled connection string (with -pooler) for serverless execution
DATABASE_URL="postgresql://neondb_owner:<password>@<neon-pooler-host>.tech/neondb?sslmode=require&connect_timeout=30&pool_timeout=30&connection_limit=10"

# Direct URL for Prisma migrations & schema inspection (optional for runtime)
DIRECT_URL="postgresql://neondb_owner:<password>@<neon-direct-host>.tech/neondb?sslmode=require"

# --- Authentication ---
JWT_SECRET="your-super-secret-jwt-key-for-production"
JWT_EXPIRES_IN="7d"

# --- CORS Origin ---
# For Unified Single Vercel Project: not strictly needed, or set to '*'
# For Two Separate Vercel Projects: set to your frontend Vercel URL
CORS_ORIGIN="*"

# --- Image Uploads (Cloudinary - Free Tier) ---
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# --- Frontend API URL ---
# For Unified Single Project deployment: leave unset or set to /api
VITE_API_URL="/api"
# For Two Separate Projects deployment: set to your backend Vercel URL
# VITE_API_URL="https://your-backend-project.vercel.app/api"
