# Frontend Environment Variables
# For Unified Single Vercel Project Deployment:
# Leave empty or set to /api (frontend and backend share the same domain)
VITE_API_URL="/api"

# For Two Separate Vercel Projects Deployment:
# Point to your deployed backend Vercel URL
# VITE_API_URL="https://your-backend-project.vercel.app/api"

# For Local Development:
# VITE_API_URL="http://localhost:5000/api"
