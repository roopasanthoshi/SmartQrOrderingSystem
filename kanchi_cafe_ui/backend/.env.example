# Backend Environment Variables (Vercel & Local Development)
PORT=5000
NODE_ENV=production

# Neon PostgreSQL Database Connection (Pooled connection recommended for serverless)
DATABASE_URL="postgresql://neondb_owner:<password>@<neon-pooler-host>.tech/neondb?sslmode=require&connect_timeout=30&pool_timeout=30&connection_limit=10"

# Direct URL for Prisma migrations & schema inspection (optional for runtime, needed for prisma db push)
DIRECT_URL="postgresql://neondb_owner:<password>@<neon-direct-host>.tech/neondb?sslmode=require"

# JWT Authentication Secrets
JWT_SECRET="your-secure-jwt-secret-key-here"
JWT_EXPIRES_IN="7d"

# CORS Origin (comma-separated origins, or '*' for all, or your Vercel frontend URL)
CORS_ORIGIN="http://localhost:5173,https://your-frontend-app.vercel.app"

# Cloudinary Image Storage Configuration (Free tier supported)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
